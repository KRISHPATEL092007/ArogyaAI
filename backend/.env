# Change this to a long random string before deploying anywhere real.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying

# Port the Flask dev server listens on (must match the proxy target in
# ../vite.config.js if you change it).
PORT=5000

# Turn off Flask's debug/auto-reload for a production-ish run.
FLASK_DEBUG=1

PING_MESSAGE=ping pong
